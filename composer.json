{
    "name": "invoicexml/zugferd-xrechnung",
    "description": "PHP client for ZUGFeRD and XRechnung e-invoices: create, validate, embed, render and extract EN 16931 invoices with the InvoiceXML API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "zugferd",
        "xrechnung",
        "e-rechnung",
        "erechnung",
        "e-invoice",
        "e-invoicing",
        "einvoice",
        "invoice",
        "en16931",
        "en-16931",
        "cii",
        "ubl",
        "pdf-a-3",
        "kosit",
        "leitweg-id",
        "validation"
    ],
    "homepage": "https://www.invoicexml.com",
    "authors": [
        {
            "name": "InvoiceXML",
            "homepage": "https://www.invoicexml.com"
        }
    ],
    "support": {
        "docs": "https://www.invoicexml.com/docs",
        "issues": "https://github.com/InvoiceXML/invoicexml-php-zugferd-xrechnung/issues",
        "source": "https://github.com/InvoiceXML/invoicexml-php-zugferd-xrechnung"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "InvoiceXml\\ZugferdXrechnung\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InvoiceXml\\ZugferdXrechnung\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
